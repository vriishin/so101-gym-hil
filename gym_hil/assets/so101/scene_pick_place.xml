<mujoco model="so101_pick_place">
  <include file="robot.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <global offwidth="128" offheight="128"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.45 0.55" rgb2="0.05 0.05 0.08" width="512" height="3072"/>
    <material name="table_material" rgba="0.48 0.32 0.20 1"/>
    <material name="cube_material" rgba="0.85 0.10 0.08 1"/>
    <material name="target_material" rgba="0.10 0.65 0.20 0.45"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.2 -0.3 1.2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="1 1 0.05" rgba="0.15 0.17 0.20 1"/>
    <geom name="table" type="box" pos="0 -0.20 -0.025" size="0.45 0.45 0.025" material="table_material"/>

    <body name="cube" pos="0.22 -0.18 0.02">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.018 0.018 0.018" mass="0.035"
            friction="1.0 0.01 0.001" material="cube_material"/>
      <site name="cube_center" size="0.004" rgba="1 1 1 0"/>
    </body>

    <body name="target" mocap="true" pos="0.20 -0.32 0.002">
      <geom name="target_region" type="cylinder" size="0.045 0.002" contype="0" conaffinity="0"
            material="target_material"/>
    </body>

    <camera name="front" pos="0.55 0.35 0.42" xyaxes="-0.72 0.69 0 -0.36 -0.38 0.85" fovy="48"/>
  </worldbody>

  <!-- Activated dynamically only after the validated bilateral grasp predicate. -->
  <equality>
    <weld name="grasp_assist" body1="gripper" body2="cube" active="false" solref="0.01 1"/>
  </equality>
</mujoco>
